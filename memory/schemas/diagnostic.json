{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DiagnosticArtifact",
  "type": "object",
  "required": ["id", "type", "integration_id", "status", "checks"],
  "properties": {
    "id": {"type": "string", "pattern": "^diag:"},
    "type": {"const": "diagnostic"},
    "integration_id": {"type": "string"},
    "status": {"enum": ["passed", "failed", "partial"]},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "status": {"type": "string"}
        }
      }
    },
    "report_url": {"type": "string"},
    "purpose": {"type": "string"},
    "redaction_mask": {"type": "array", "items": {"type": "string"}}
  }
}
