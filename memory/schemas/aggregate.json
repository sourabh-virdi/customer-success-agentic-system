{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentAggregates",
  "type": "object",
  "required": ["id", "type"],
  "properties": {
    "id": {"type": "string"},
    "type": {"const": "aggregate"},
    "churn_score": {"type": "number"},
    "repeated_issues": {"type": "array", "items": {"type": "string"}},
    "escalation_count": {"type": "integer"},
    "purpose": {"type": "string"}
  }
}
