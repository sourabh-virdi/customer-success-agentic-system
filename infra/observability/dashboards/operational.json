{
  "title": "CS Agent System - Operational Dashboard",
  "panels": [
    {
      "title": "Session Throughput",
      "type": "graph",
      "targets": [{"expr": "rate(agent_request_count[5m])", "legend": "requests/s"}]
    },
    {
      "title": "Latency p50/p95",
      "type": "graph",
      "targets": [
        {"expr": "histogram_quantile(0.5, agent_request_latency)", "legend": "p50"},
        {"expr": "histogram_quantile(0.95, agent_request_latency)", "legend": "p95"}
      ]
    },
    {
      "title": "Tool Error Heatmap",
      "type": "heatmap",
      "targets": [{"expr": "mcp_tool_calls_total{outcome=\"error\"}"}]
    },
    {
      "title": "Tool Success Rate",
      "type": "stat",
      "targets": [{"expr": "sum(mcp_tool_calls_total{outcome=\"success\"}) / sum(mcp_tool_calls_total)"}]
    }
  ]
}
